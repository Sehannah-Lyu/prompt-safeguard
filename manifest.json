{
  "manifest_version": 3,
  "name": "Prompt Safeguard",
  "description": "Local prompt history and reusable templates for ChatGPT, Doubao, Gemini, Claude, DeepSeek and other chatbots.",
  "version": "3.1.3",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://www.doubao.com/*",
    "https://doubao.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [{
    "matches": [
      "https://chatgpt.com/*",
      "https://chat.openai.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*",
      "https://chat.deepseek.com/*",
      "https://www.doubao.com/*",
      "https://doubao.com/*"
    ],
    "js": ["core.js", "adapters.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "Prompt Safeguard",
    "default_popup": "popup.html"
  }
}
